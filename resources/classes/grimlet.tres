[resource]
script = ExtResource("1_vbr10")
id = "grimlet"
display_name = "Grimlet"
tagline = "Grm. We are the forest's fist."
lore = "Grimlets grow, they are not born: when an elder cap falls, a grimlet sprouts from it, carrying a little of the elder's memory. They live in hollow mushroom-cities and root-halls deep under the meadow, speak as 'we', and guard the Key of Growth. When a grimlet dies, it 'goes to loam' — and something new grows there."
trial = "The Stone of Growth asks you to wake a gate of roots that has slept for a thousand years."
