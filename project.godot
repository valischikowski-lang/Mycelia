; Engine configuration file.
; MYCELIA — The Dreaming Realms
; Input actions are registered at runtime by scripts/core/input_config.gd so they can be rebound and persisted.

config_version=5

[application]

config/name="MYCELIA — The Dreaming Realms"
config/description="A surreal psychedelic fantasy RPG with first-person exploration and tactical spell-card combat."
config/version="0.1.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.047, 0.02, 0.09, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
Settings="*res://scripts/core/settings.gd"
Database="*res://scripts/core/database.gd"
Game="*res://scripts/core/game.gd"
SaveManager="*res://scripts/save/save_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
SceneFlow="*res://scripts/core/scene_flow.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="creature"
3d_physics/layer_5="trigger"

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.5

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.047, 0.02, 0.09, 1)
anti_aliasing/quality/msaa_3d=1
