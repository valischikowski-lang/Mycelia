extends Node
## Central audio: bus layout (Master/Music/Ambient/Effects/UI), a pooled
## set of SFX voices, cross-fading music and an ambience layer. Sounds are
## resolved by name from res://assets/audio/<name>.wav (generated by
## tools/generate_audio.py). Missing sounds are skipped silently once warned.

const AUDIO_DIR := "res://assets/audio/"
const BUSES: PackedStringArray = ["Music", "Ambient", "Effects", "UI"]
const POOL_SIZE := 12
const LOOPING: PackedStringArray = ["music_meadow", "music_combat", "music_menu", "music_boss", "meadow_ambience"]
const UI_SOUNDS: PackedStringArray = ["ui_click", "ui_hover", "ui_open", "ui_close", "ui_error"]

var _streams: Dictionary = {}
var _missing: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _pool_index: int = 0
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_current: String = ""
var _ambience: AudioStreamPlayer
var _ambience_current: String = ""


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = "Effects"
		add_child(p)
		_pool.append(p)
	_music_a = _make_player("Music")
	_music_b = _make_player("Music")
	_ambience = _make_player("Ambient")
	apply_volumes()
	Settings.changed.connect(func(section: String) -> void:
		if section == "audio":
			apply_volumes())


func _make_player(bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	add_child(p)
	return p


func _setup_buses() -> void:
	for b: String in BUSES:
		if AudioServer.get_bus_index(b) == -1:
			AudioServer.add_bus()
			var idx := AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, b)
			AudioServer.set_bus_send(idx, "Master")
	# Gentle shared reverb on effects for a dreamy space.
	var fx_idx := AudioServer.get_bus_index("Effects")
	if AudioServer.get_bus_effect_count(fx_idx) == 0:
		var rv := AudioEffectReverb.new()
		rv.room_size = 0.6
		rv.wet = 0.12
		rv.dry = 1.0
		AudioServer.add_bus_effect(fx_idx, rv)


func apply_volumes() -> void:
	for bus: String in Settings.volumes.keys():
		var idx := AudioServer.get_bus_index(bus)
		if idx >= 0:
			var v := float(Settings.volumes[bus])
			AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(v, 0.0001)))
			AudioServer.set_bus_mute(idx, v <= 0.001)


func get_stream(sound: String) -> AudioStream:
	if _streams.has(sound):
		return _streams[sound]
	if _missing.has(sound):
		return null
	var path := AUDIO_DIR + sound + ".wav"
	if not ResourceLoader.exists(path):
		_missing[sound] = true
		push_warning("AudioManager: sound '%s' not found" % sound)
		return null
	var s: AudioStream = load(path)
	if s is AudioStreamWAV and sound in LOOPING:
		var w := s as AudioStreamWAV
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = int(w.get_length() * w.mix_rate)
	_streams[sound] = s
	return s


func play_sfx(sound: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var s := get_stream(sound)
	if s == null:
		return
	var p := _pool[_pool_index]
	_pool_index = (_pool_index + 1) % _pool.size()
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.bus = "UI" if sound in UI_SOUNDS else "Effects"
	p.play()


func play_ui(sound: String = "ui_click") -> void:
	play_sfx(sound, -4.0)


## Spatialized one-shot attached to the scene; frees itself.
func play_at(sound: String, where: Vector3, parent: Node, volume_db: float = 0.0) -> void:
	var s := get_stream(sound)
	if s == null or parent == null:
		return
	var p := AudioStreamPlayer3D.new()
	p.stream = s
	p.bus = "Effects"
	p.volume_db = volume_db
	p.unit_size = 6.0
	p.max_distance = 60.0
	parent.add_child(p)
	p.global_position = where
	p.finished.connect(p.queue_free)
	p.play()


func play_music(track: String, fade_time: float = 1.5) -> void:
	if track == _music_current:
		return
	_music_current = track
	var s := get_stream(track) if track != "" else null
	var incoming := _music_b if _music_a.playing else _music_a
	var outgoing := _music_a if incoming == _music_b else _music_b
	if outgoing.playing:
		var tw := create_tween()
		tw.tween_property(outgoing, "volume_db", -60.0, fade_time)
		tw.tween_callback(outgoing.stop)
	if s:
		incoming.stream = s
		incoming.volume_db = -40.0
		incoming.play()
		create_tween().tween_property(incoming, "volume_db", 0.0, fade_time)


func play_ambience(track: String, fade_time: float = 2.0) -> void:
	if track == _ambience_current:
		return
	_ambience_current = track
	if track == "":
		create_tween().tween_property(_ambience, "volume_db", -60.0, fade_time)
		return
	var s := get_stream(track)
	if s == null:
		return
	_ambience.stream = s
	_ambience.volume_db = -40.0
	_ambience.play()
	create_tween().tween_property(_ambience, "volume_db", -4.0, fade_time)


func duck_ambience(on: bool) -> void:
	create_tween().tween_property(_ambience, "volume_db", -22.0 if on else -4.0, 0.8)
